# Only VITE_ variables reach the browser, and they are public once built.
# Never put a key in one: the Azure OpenAI key lives in McpServer's .env.

# MCP Server Configuration (Backend)
# Where McpServer's Web API runs (Vite's proxy in vite.config.js sends /api to
# http://localhost:5000; the Node search proxy reads this)
VITE_MCP_SERVER_URL=http://localhost:5000

# Azure Search Configuration (Optional - for the Node search proxy, server side)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_APIKEY=your-search-admin-key
AZURE_SEARCH_INDEX=your-index-name

# Server Configuration
PORT=5001
